LatexExpression = LatexExpression LatexSymbol | LatexSymbol;

LatexSymbol = LatexSymbol UNDERSCORE BaseLatexSymbol
            | LatexSymbol CIRCUMFLEX BaseLatexSymbol
            | BaseLatexSymbol;
BaseLatexSymbol = LEFT_BRACKET LatexExpression RIGHT_BRACKET
                | LATEX_SYMBOL LatexArguments
                | LATEX_SYMBOL
                | PlaceHolder;

LatexArguments = LatexArguments LatexArgument | LatexArgument;

LatexArgument = LEFT_SQUARE_BRACKET LatexExpression RIGHT_SQUARE_BRACKET
         | LEFT_BRACKET LatexExpression RIGHT_BRACKET;

PlaceHolder = HASHTAG LEFT_BRACKET Notation RIGHT_BRACKET;

