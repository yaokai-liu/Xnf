LatexExpression = LatexExpression LatexSymbol | LatexSymbol;

LatexSymbol = LatexSymbol UNDERSCORE BaseLatexSymbol
            | LatexSymbol CIRCUMFLEX BaseLatexSymbol
            | BaseLatexSymbol;
BaseLatexSymbol = LEFT_PARENTHESIS LatexExpression RIGHT_PARENTHESIS
                | LEFT_BRACKET LatexExpression RIGHT_BRACKET
                | LATEX_SYMBOL Arguments
                | LATEX_SYMBOL;

Arguments = Arguments Argument | Argument;

Argument = LEFT_SQUARE_BRACKET LatexExpression RIGHT_SQUARE_BRACKET
         | LEFT_BRACKET LatexExpression RIGHT_BRACKET;
