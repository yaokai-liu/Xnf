
Regex = Regex SPLIT Branch | Branch |;
Branch = Branch Object | Object;
Object = CHAR | Charset | Group | Quantified
       | NOT CHAR | NOT Charset | NOT Group
       | ASSERT Object;
Charset = BEGIN_CHARSET UnitArray END_CHARSET | SET_ESCAPE;
UnitArray = UnitArray Unit | Unit;
Unit = CHAR | Range | Charset | NOT CHAR | NOT Charset;
Group = BEGIN_GROUP Regex END_GROUP;
Quantified = Object Quantifier;
Quantifier = QUEST | PLUS | TIMES
           | BEGIN_QUANTIFIER NUMBER COMMA NUMBER END_QUANTIFIER
           | BEGIN_QUANTIFIER NUMBER COMMA END_QUANTIFIER
           | BEGIN_QUANTIFIER COMMA NUMBER END_QUANTIFIER
           | BEGIN_QUANTIFIER NUMBER END_QUANTIFIER;
Range = CHAR MINUS CHAR;
