
MathEntry = Definition | Theorem | Procedure;

Definition = DEFINITION_TYPE DefHeader TextBlock DENOTEAS LEFT_BRACKET NotationDefinitions RIGHT_BRACKET
           | DEFINITION_TYPE DefHeader TextBlock;
Theorem = THEOREM_TYPE ThmHeader TextBlock ProofBlock
        | AXIOM_TYPE ThmHeader TextBlock;
Procedure = PROCEDURE ProcHeader ActionBlock DENOTEAS LEFT_BRACKET NotationDefinitions RIGHT_BRACKET
          | PROCEDURE ProcHeader ActionBlock;

DefHeader = LEFT_PARENTHESIS NounPhrases RIGHT_PARENTHESIS;
ThmHeader = LEFT_PARENTHESIS NounPhrases RIGHT_PARENTHESIS | ;
ProcHeader = LEFT_PARENTHESIS Verb RIGHT_PARENTHESIS;
NotationDefinitions = NotationDefinitions NotationDefinition | NotationDefinition;

NotationDefinition = LEFT_SQUARE_BRACKET NounPhrase RIGHT_SQUARE_BRACKET NotationBlock LATEX LatexExpression SEMICOLON;

NounPhrases = NounPhrases COMMA NounPhrase | NounPhrase;
TextBlock = LEFT_BRACKET Sentences RIGHT_BRACKET;
ActionBlock = LEFT_BRACKET OperaSentences RIGHT_BRACKET;
ProofBlock = PROOF LEFT_BRACKET Sentences RIGHT_BRACKET;

Sentences = Sentences Sentence | Sentence;
StateSentences = StateSentences StateSentence | StateSentence;
OperaSentences = OperaSentences OperaSentence | OperaSentence;

Sentence = StateSentence | OperaSentence;
StateSentence = Statement DOT;
OperaSentence = Operation DOT;

Statement = Complement COMMA Statement
          | Statement Complement
          | Subjective Verb Objective Objective
          | Subjective Verb Objective
          | Subjective Verb
          | WrappedStatement;
Operation = Verb Objective Objective
          | Verb Objective
          | Verb Statement;

WrappedStatement = DOUBLE_LEFT_SQUARE_BRACKET Statement DOUBLE_RIGHT_SQUARE_BRACKET;

Subjective = Objective | PRONOUN;
Objective = NounPhrase LEFT_BRACKET Notation RIGHT_BRACKET | NounPhrase;
Verb = Adverb VERB Complement
     | VERB Complement
     | Adverb VERB
     | VERB;

NounPhrase = THE NUMBER PREP BareNounPhrase
           | THE NUMBER PREP Refer
           | NUMBER BareNounPhrase
           | BareNounPhrase
           | NUMBER Refer
           | Numeric
           | Refer;

BareNounPhrase = LEFT_BRACKET NounPhrases RIGHT_BRACKET
               | Adjective NOUN Complement
               | NOUN Complement
               | Adjective NOUN;


Adjective = Adjective Adverb ADJECTIVE | Adverb ADJECTIVE;
Adverb = Adverb ADVERB | ADVERB;
Complement = Adverb | Adjective | PREP Objective | CONJUNCTION Statement;

Refer = LEFT_ANGLE_BRACKET BareNounPhrase RIGHT_ANGLE_BRACKET
      | LEFT_ANGLE_BRACKET Verb RIGHT_ANGLE_BRACKET;

Numeric = LEFT_BRACKET NUMBER RIGHT_BRACKET;

