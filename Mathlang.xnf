
MathEntry = PreProcessMacro | Definition | Theorem | Procedure | StateSentences;

PreProcessMacro = HASHTAG FROM PATH_STRING IMPORT LEFT_BRACKET NounPhrase RIGHT_BRACKET AS LEFT_BRACKET NounPhrase RIGHT_BRACKET SEMICOLON
                | HASHTAG FROM PATH_STRING IMPORT LEFT_BRACKET NounPhrases RIGHT_BRACKET SEMICOLON
                | HASHTAG FROM PATH_STRING IMPORT STAR SEMICOLON
                | HASHTAG IMPORT LEFT_BRACKET PathStrings RIGHT_BRACKET SEMICOLON
                | HASHTAG INTRO IntroItems SEMICOLON;

Definition = DEFINITION_TYPE DefHeader TextBlock DENOTE LEFT_BRACKET NotationDefinitions RIGHT_BRACKET
           | DENOTE LEFT_BRACKET NotationDefinitions RIGHT_BRACKET
           | DEFINITION_TYPE DefHeader TextBlock;
Theorem = THEOREM_TYPE ThmHeader TextBlock PROOF TextBlock
        | AXIOM_TYPE ThmHeader TextBlock;
Procedure = PROCEDURE ProcHeader LEFT_BRACKET OperaSentences RIGHT_BRACKET DENOTE LEFT_BRACKET NotationDefinitions RIGHT_BRACKET
          | PROCEDURE ProcHeader LEFT_BRACKET OperaSentences RIGHT_BRACKET;

IntroItems = IntroItems COMMA IntroItem | IntroItem;
IntroItem = IDENTIFIER AS WORD_CAT FROM IDENTIFIER
          | IDENTIFIER AS WORD_CAT;

DefHeader = LEFT_PARENTHESIS BareNounPhrase RIGHT_PARENTHESIS;
ThmHeader = LEFT_PARENTHESIS BareNounPhrase RIGHT_PARENTHESIS | ;
ProcHeader = LEFT_PARENTHESIS Verb RIGHT_PARENTHESIS;
NotationDefinitions = NotationDefinitions NotationDefinition | NotationDefinition;
PathStrings = PathStrings COMMA PATH_STRING | PATH_STRING;

NotationDefinition = LEFT_SQUARE_BRACKET NounPhrase RIGHT_SQUARE_BRACKET LEFT_PARENTHESIS Notations RIGHT_PARENTHESIS
                         AS LATEX_DELIMITER LatexExpression LATEX_DELIMITER SEMICOLON
                   | DOUBLE_LEFT_SQUARE_BRACKET Sentence DOUBLE_RIGHT_SQUARE_BRACKET LEFT_PARENTHESIS Notations RIGHT_PARENTHESIS
                         AS LATEX_DELIMITER LatexExpression LATEX_DELIMITER SEMICOLON;

TextBlock = LEFT_BRACKET Sentences RIGHT_BRACKET;

Sentences = Sentences Sentence | Sentence;
StateSentences = StateSentences StateSentence | StateSentence;
OperaSentences = OperaSentences OperaSentence | OperaSentence;

Sentence = StateSentence | OperaSentence;
StateSentence = Statement DOT;
OperaSentence = Operation DOT;

Statement = DOUBLE_LEFT_SQUARE_BRACKET Statement DOUBLE_RIGHT_SQUARE_BRACKET
          | Complement COMMA Statement
          | Statement COMMA Complement
          | Statement Complement
          | Subjective Operation
          | Subjective;

Operation = Verb NounPhrases | Verb;

Subjective = NounPhrases | PRONOUN;
Verb = Adverb VERB Complement
     | VERB Complement
     | Adverb VERB
     | VERB;

NounPhrases = NounPhrases COMMA NounPhrase CONJUNCTION NounPhrase
            | NounPhrase CONJUNCTION NounPhrase
            | NounPhrase COMMA NounPhrase
            | NounPhrase;

NounPhrase = LEFT_BRACKET NUMBER RIGHT_BRACKET
           | ARTICLE NUMBER PREP BareNounPhrase
           | ARTICLE NUMBER PREP Refer
           | NUMBER BareNounPhrase
           | BareNounPhrase
           | NUMBER Refer
           | Refer;

BareNounPhrase = Adjective NotedNoun Complement
               | NotedNoun Complement
               | Adjective NotedNoun
               | NotedNoun;

NotedNoun = NOUN LEFT_BRACKET Notations RIGHT_BRACKET
          | LEFT_BRACKET Notations RIGHT_BRACKET
          | NOUN;

Adjective = Adjective Adverb ADJECTIVE | Adverb ADJECTIVE;
Adverb = Adverb ADVERB | ADVERB;
Complement = Adverb | Adjective | PREP NounPhrase | CLAUSE Statement;

Notations = Notations COMMA Notation | Notation;

Refer = LEFT_ANGLE_BRACKET PATH_STRING COLON BareNounPhrase RIGHT_ANGLE_BRACKET
      | LEFT_ANGLE_BRACKET PATH_STRING COLON Verb RIGHT_ANGLE_BRACKET
      | LEFT_ANGLE_BRACKET BareNounPhrase RIGHT_ANGLE_BRACKET
      | LEFT_ANGLE_BRACKET Verb RIGHT_ANGLE_BRACKET;

LatexExpression = LatexExpression LatexSymbol | LatexSymbol;
LatexSymbol = BareLatexSymbol CIRCUMFLEX LatexSymbol
            | BareLatexSymbol UNDERSCORE LatexSymbol
            | BareLatexSymbol;

BareLatexSymbol = LEFT_SQUARE_BRACKET LatexExpression RIGHT_SQUARE_BRACKET
                | LEFT_PARENTHESIS LatexExpression RIGHT_PARENTHESIS
                | LEFT_BRACKET LatexExpression RIGHT_BRACKET
                | HASHTAG LEFT_BRACKET Notation RIGHT_BRACKET
                | LATEX_COMMAND
                | LATEX_SYMBOL;

NotationSymbol = LATEX_COMMAND LEFT_BRACKET LATEX_SYMBOL RIGHT_BRACKET
               | LATEX_COMMAND LEFT_BRACKET Notation RIGHT_BRACKET
               | LATEX_SYMBOL;

Notation = NotationSymbol LEFT_PARENTHESIS Notations RIGHT_PARENTHESIS
         | NotationSymbol
         | NUMBER;
