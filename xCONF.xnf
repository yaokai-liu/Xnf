Object = LEFT_BRACKET Pairs RIGHT_BRACKET
       | LEFT_BRACKET Pairs COMMA RIGHT_BRACKET;

Pairs = Pair | Pairs COMMA Pair;

Pair = LEFT_SQUARE_BRACKET Path RIGHT_SQUARE_BRACKET ASSIGN Value
     | LEFT_SQUARE_BRACKET Path RIGHT_SQUARE_BRACKET COLON Value
     | LEFT_SQUARE_BRACKET Path RIGHT_SQUARE_BRACKET Value
     | Path ASSIGN Value
     | Path COLON  Value;

Path = Path DOT KEY | DOT KEY | KEY;

Value = Object | List | NUMBER | Texts | BOOLEAN | NULL;

List = LEFT_SQUARE_BRACKET Values RIGHT_SQUARE_BRACKET
     | LEFT_SQUARE_BRACKET Values COMMA RIGHT_SQUARE_BRACKET;

Values = Value | Values COMMA Value;

Texts = Texts TEXT | TEXT;
