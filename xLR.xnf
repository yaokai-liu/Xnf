
GrammarEntry = EnumDeclaration SEMICOLON
             | TypeDefinition SEMICOLON
             | AttrDefinition SEMICOLON
             | TypeRenaming SEMICOLON
             | AttrRenaming SEMICOLON
             | FuncDefinition
             | RuleDefinition;

EnumDeclaration = ENUM IDENTIFIER LEFT_BRACKET EnumItems RIGHT_BRACKET
                | ENUM IDENTIFIER COLON IDENTIFIER LEFT_BRACKET EnumItems RIGHT_BRACKET;
TypeDefinition = AttrList TYPEHINT IDENTIFIER LEFT_BRACKET Declarations RIGHT_BRACKET;
AttrDefinition = AttrList ATTRIBUTE IDENTIFIER LEFT_PARENTHESIS Parameters RIGHT_PARENTHESIS ActionBlock
               | AttrList ATTRIBUTE IDENTIFIER ActionBlock;
RuleDefinition = Type AttrList RULE IDENTIFIER LEFT_PARENTHESIS Pattern RIGHT_PARENTHESIS ActionBlock;
FuncDefinition = Type AttrList IDENTIFIER LEFT_PARENTHESIS Parameters RIGHT_PARENTHESIS ActionBlock;
TypeRenaming = TYPEDEF Type AttrList IDENTIFIER LEFT_PARENTHESIS Parameters RIGHT_PARENTHESIS
             | TYPEDEF Type AttrList IDENTIFIER Subscriber
             | TYPEDEF Type AttrList IDENTIFIER;
AttrRenaming = ATTRDEF AttrList ATTRNAME LEFT_PARENTHESIS Arguments RIGHT_PARENTHESIS IDENTIFIER
             | ATTRDEF AttrList ATTRNAME IDENTIFIER;

Type = TypeDefinition | AttrList TYPENAME;
AttrList = AttrList ATTRNAME LEFT_PARENTHESIS Arguments RIGHT_PARENTHESIS
         | ATTRNAME LEFT_PARENTHESIS Arguments RIGHT_PARENTHESIS
         | AttrList ATTRNAME
         | ATTRNAME
         | ;
EnumItems = EnumItems COMMA EnumItem | EnumItem;
EnumItem = IDENTIFIER ASSIGNER Evaluable | IDENTIFIER;
Declarations = Declarations Declaration | Declaration;
Declaration = AttrList TYPENAME AttrList IDENTIFIER LEFT_PARENTHESIS Parameters RIGHT_PARENTHESIS SEMICOLON
            | AttrList TYPENAME AttrList VarList SEMICOLON;
Parameters = Parameters COMMA Parameter | Parameter;
Parameter = AttrList TYPENAME AttrList IDENTIFIER Subscriber
          | AttrList TYPENAME AttrList Subscriber
          | AttrList TYPENAME AttrList IDENTIFIER
          | AttrList TYPENAME AttrList;
VarList = VarList COMMA Variable | Variable;
Variable = IDENTIFIER Subscriber ASSIGNER StructuredInitializer
         | IDENTIFIER ASSIGNER VariableInitializer
         | IDENTIFIER Subscriber
         | IDENTIFIER;

StructuredInitializer = LEFT_BRACKET VariableInitializerList RIGHT_BRACKET | LEFT_BRACKET RIGHT_BRACKET;
VariableInitializer = StructuredInitializer | ArithExpr;

VariableInitializerList = VariableInitializerList COMMA InitializerHinter ASSIGNER VariableInitializer
                        | VariableInitializerList COMMA VariableInitializer
                        | InitializerHinter ASSIGNER VariableInitializer
                        | VariableInitializer;
InitializerHinter = InitializerHinter LEFT_SQUARE_BRACKET Evaluable RIGHT_SQUARE_BRACKET
                  | LEFT_SQUARE_BRACKET Evaluable RIGHT_SQUARE_BRACKET
                  | InitializerHinter DOT IDENTIFIER
                  | DOT IDENTIFIER;

Pattern = Tokens VERTICAL_BAR Tokens | Tokens;
Tokens = Tokens Token | Tokens TEXT | Token | TEXT |;
Token = LEFT_PARENTHESIS Tokens RIGHT_PARENTHESIS
      | Token QUANTIFIER
      | SINGLE_CHAR
      | TYPENAME;

ActionStatements = ActionStatements ActionStatement | ActionStatement;
ActionStatement = CondStatement | ActionBlock | Declaration SEMICOLON | AssignExpr SEMICOLON | ControlStatement;

CondStatement = IfStatement | ForStatement | WhileStatement | CondStatement ELSE ActionStatement;
ControlStatement = BREAK SEMICOLON | CONTINUE SEMICOLON | RETURN ArithExpr SEMICOLON;

IfStatement = IF IfCondition ActionStatement;
ForStatement = FOR ForCondition ActionStatement;
WhileStatement = WHILE IfCondition ActionStatement;
ActionBlock = LEFT_BRACKET ActionStatements RIGHT_BRACKET
            | LEFT_BRACKET RIGHT_BRACKET;

IfCondition = LEFT_PARENTHESIS CondExpr RIGHT_PARENTHESIS;
ForCondition = LEFT_PARENTHESIS OptionalLoopInitExpr SEMICOLON
                                OptionalLoopCondExpr SEMICOLON
                                OptionalLoopUpdateExpr RIGHT_PARENTHESIS;

OptionalLoopInitExpr = Declaration | AssignExpr | ;
OptionalLoopUpdateExpr = AssignExpr | ;
OptionalLoopCondExpr = CondExpr | ;

CondExpr = CondExpr COND_BIN_OP CompExpr | CompExpr;

CompExpr = COND_SIN_OP CompExpr
         | ArithExpr COMPARE_OP ArithExpr
         | ArithExpr;

AssignExpr = Assignable ASSIGNER ArithExpr
           | INTEGRATED_OP IntegratedExpr
           | IntegratedExpr INTEGRATED_OP;

ArithExpr = Arith_0_Expr | AssignExpr | LEFT_PARENTHESIS CondExpr RIGHT_PARENTHESIS;

Arith_0_Expr = Arith_0_Expr ARITH_0_OP Arith_1_Expr
             | ARITH_0_OP Arith_0_Expr
             | Arith_1_Expr;
Arith_1_Expr = Arith_1_Expr ARITH_1_BIN_OP Arith_2_Expr
             | ARITH_1_SIN_OP Arith_1_Expr
             | Arith_2_Expr;
Arith_2_Expr = Arith_2_Expr ARITH_2_BIN_OP Arith_3_Expr
             | ARITH_2_SIN_OP Arith_2_Expr
             | Arith_3_Expr;
Arith_3_Expr = Arith_3_Expr ARITH_3_BIN_OP Arith_4_Expr
             | ARITH_3_SIN_OP Arith_4_Expr
             | Arith_4_Expr;
Arith_4_Expr = ARITH_4_SIN_OP Arith_4_Expr
             | Evaluable;

Evaluable = ENUM_GROUP DOUBLE_COLON IDENTIFIER
          | IntegratedExpr
          | FunctionCall
          | LiteralValue;

LiteralValue = VAL_LITERAL | SINGLE_CHAR | LiteralTexts;

LiteralTexts = LiteralTexts TEXT | TEXT;

Assignable = IDENTIFIER | Accessed | Subscribed | Attributed;
Accessed = IntegratedExpr DOT IDENTIFIER;
Subscribed = IntegratedExpr Subscriber;
Attributed = IntegratedExpr GET IDENTIFIER;

Subscriber =  LEFT_SQUARE_BRACKET ArithExpr RIGHT_SQUARE_BRACKET;

IntegratedExpr = LEFT_PARENTHESIS ArithExpr RIGHT_PARENTHESIS | Assignable | BUILTIN_IDENTIFIER;

FunctionCall = FUNCNAME LEFT_PARENTHESIS Arguments RIGHT_PARENTHESIS;

Arguments = Arguments COMMA Argument | Argument | ;
Argument = IDENTIFIER ASSIGNER VariableInitializer | VariableInitializer;
